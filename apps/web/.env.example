# Copy to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
# Only needed if Anthropic's API says your key "is not scoped to a workspace" —
# find it at console.anthropic.com (Settings -> the workspace -> copy its ID)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=

WORKER_URL=
WORKER_SHARED_SECRET=

# Must match apps/worker/.env.local exactly — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

BUG_TRACKER_BASE_URL=
BUG_TRACKER_API_KEY=
